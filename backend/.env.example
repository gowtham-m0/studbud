# StudBud backend environment template.
DATABASE_URL=postgresql+asyncpg://studbud:studbud@localhost:5432/studbud
ENVIRONMENT=development
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
KEY_PEPPER=change-this-to-a-long-random-string
ADMIN_API_SECRET=dev-admin-secret-change-me
SESSION_TTL_DAYS=7
ACCESS_KEY_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_ORIGINS=http://localhost:3000
AUTO_CREATE_TABLES=false
WORKER_ENABLED=true
MAX_UPLOAD_MB=25
MAX_PAGES=200
USER_MAX_DOCUMENTS=50
USER_MAX_PAGES=5000
USER_MAX_STORAGE_MB=1024
USER_DAILY_UPLOADS=20
USER_DAILY_EXPLANATIONS=100
SIGN_IN_RATE_LIMIT=10
ADMIN_RATE_LIMIT=60
CHAT_RATE_LIMIT=20

# Storage: auto | local | r2
STORAGE_BACKEND=auto
STORAGE_DIR=storage
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=studbud
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Groq: chat and optional vision. Embeddings run locally via FastEmbed by default.
# Without GROQ_API_KEY, ingestion/search still work; explanations return 503.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Vision captions: auto/gemini = Gemini if GEMINI_API_KEY is set;
# groq = explicitly use a Groq vision model; none = disabled.
VISION_PROVIDER=auto
# Gemini has a free vision tier; use it when Groq has no vision model.
# GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=nomic-embed-text-v1_5
EMBEDDING_DIM=768
# auto/fastembed = local model; gemini = hosted, low-memory; groq = hosted (may 404);
# hash = offline fallback
EMBEDDING_PROVIDER=auto
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LOCAL_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5-Q
EMBEDDING_THREADS=2
# FASTEMBED_CACHE_DIR=

# Page/section chunking and figures
CHUNK_TARGET_TOKENS=650
CHUNK_OVERLAP_TOKENS=100
MAX_FIGURES_PER_PAGE=8
MAX_FIGURE_CAPTIONS=24
PAGE_PREVIEW_DPI=100
FIGURE_CAPTIONING_ENABLED=true
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=200
